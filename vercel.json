{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/register.html",
      "has": [
        {
          "type": "host",
          "value": "www.finflare.online"
        }
      ],
      "destination": "https://finflare.online",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "register.finflare.online"
        }
      ],
      "destination": "/register.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "register.finflare.online"
        }
      ],
      "destination": "/:path*"
    }
  ]
}
